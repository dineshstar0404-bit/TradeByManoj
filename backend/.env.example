# ─────────────────────────────────────────────
# MANOJ TRADERS — Backend Environment Variables
# Copy to .env and fill real values before deploying
# ─────────────────────────────────────────────

PORT=5000
NODE_ENV=production

# MongoDB Atlas
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/manoj_traders?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_with_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=30d

# Cloudinary (bill photo uploads)
# Get from: https://cloudinary.com/console
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Admin seed account (used by: npm run seed:admin)
SEED_ADMIN_ID=admin
SEED_ADMIN_PASSWORD=admin123
SEED_ADMIN_NAME=Manoj Traders Admin

# Admin password recovery key (no OTP — just this key)
# Change before going live. Never commit real value to git.
ADMIN_RECOVERY_KEY=testing123

# CORS — comma-separated allowed origins (* = allow all)
CLIENT_ORIGINS=*
